{
  "name": "SafePaste health check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "a1f0c1d2-0001-4000-8000-000000000001",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://safepaste.duckdns.org/api/health",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1f0c1d2-0002-4000-8000-000000000002",
      "name": "Call health endpoint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1f0c1d2-0003-4000-8000-00000000000a",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c1d2-0003-4000-8000-000000000003",
      "name": "Is it healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        -80
      ]
    },
    {
      "parameters": {
        "fromEmail": "YOUR_EMAIL_ADDRESS",
        "toEmail": "YOUR_EMAIL_ADDRESS",
        "subject": "SafePaste API problem",
        "emailFormat": "text",
        "text": "=The SafePaste health check failed.\n\nStatus: {{ $json.status || 'no answer' }}\nDetails: {{ JSON.stringify($json).slice(0, 300) }}\n\nChecked: https://safepaste.duckdns.org/api/health",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a1f0c1d2-0004-4000-8000-000000000004",
      "name": "Alert by email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        680,
        80
      ]
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Call health endpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call health endpoint": {
      "main": [
        [
          {
            "node": "Is it healthy?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert by email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is it healthy?": {
      "main": [
        [],
        [
          {
            "node": "Alert by email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
