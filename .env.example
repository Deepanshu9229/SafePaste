# Copy to .env.local and fill in. Values are built into the static site, so they are public.

# Base URL of the SafePaste API (no trailing slash). Leave empty to turn the AI features off.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Cloudflare Turnstile site key. The value below is Cloudflare's test key that always passes;
# use it only for local development together with the test secret in server/.env.example.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
