# Copy to .env and fill in. Never commit .env.

# Port the API listens on (127.0.0.1 only; Caddy forwards /api/* to it).
PORT=8080

# Ollama on the same machine.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Websites allowed to call the API, comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:3000

# Cloudflare Turnstile secret key. The value below is Cloudflare's test key that always passes;
# use it only for local development together with the test site key 1x00000000000000000000AA.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Optional: usage logging to PostgreSQL (table in sql/001_usage_logs.sql).
# Leave DATABASE_URL out to turn logging off. With it, VISITOR_HASH_SECRET is required:
# a long random string used to hash IP addresses (generate with: openssl rand -hex 32).
# DATABASE_URL=postgres://safepaste:PASSWORD@127.0.0.1:5432/safepaste
# VISITOR_HASH_SECRET=
